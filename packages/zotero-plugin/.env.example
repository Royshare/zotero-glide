# Copy this file to .env and fill in the paths below.
# See STATUS.md's "Zotero dev loading" section for why this is the
# recommended path (zotero-plugin-scaffold's RDP-based temporary-addon
# install), as opposed to scripts/dev-profile.sh's proxy-file approach.

# Path to the Zotero binary. On macOS: "/Applications/Zotero.app/Contents/MacOS/zotero"
# (or a beta build, e.g. "/Applications/Zotero 2.app/Contents/MacOS/zotero").
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero

# An ISOLATED profile directory for development -- never your real Zotero
# profile (brief §14: don't develop against production data). Created
# automatically if missing.
ZOTERO_PLUGIN_PROFILE_PATH = /path/to/dev-profile

# An isolated data directory (library/storage). Leave empty to use the
# profile's default data location.
ZOTERO_PLUGIN_DATA_DIR = /path/to/dev-data
