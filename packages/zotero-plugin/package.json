{
  "name": "zotero-fast-reader-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Zotero 10 plugin: adds \"Open in Fast Reader\" and launches the fast-reader-helper native process. See ../../docs/adr/001-reader-helper-stack.md.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-dev/zotero-glide.git"
  },
  "config": {
    "addonName": "Zotero Fast Reader",
    "addonID": "fast-reader@zotero-glide.local",
    "addonRef": "fast-reader",
    "addonInstance": "FastReader",
    "prefsPrefix": "extensions.zotero.fast-reader"
  },
  "scripts": {
    "test": "node --test",
    "prestart": "bash ../../scripts/build-helper.sh",
    "start": "zotero-plugin serve",
    "prebuild": "bash ../../scripts/build-helper.sh",
    "build": "zotero-plugin build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "release": "zotero-plugin release"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.3",
    "zotero-types": "^4.1.3"
  }
}
